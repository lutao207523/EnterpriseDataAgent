# Optional Pi Agent SDK model connection. The local planner works without these values.
PI_PROVIDER=openai-completions
PI_MODEL=gpt-4o-mini
PI_API_KEY=
PI_BASE_URL=https://api.openai.com/v1

# Optional LLM Wiki HTTP endpoint. Without it, wiki/fields.json is used.
LLM_WIKI_URL=
LLM_WIKI_TOKEN=

# Data limits
MAX_ROWS=200000
MAX_FILE_BYTES=524288000
